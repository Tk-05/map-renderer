# Copy to .env (next to docker-compose.yml) and adjust.

# Realm name or id (list them with: docker compose run --rm renderer map-renderer realm list)
REALM=My Realm

# Pause between two renders: 30m, 6h, 1d, ...
INTERVAL=6h

# Port of the web map on this machine
PORT=8080

# Keep the map in a host folder instead of the Docker volume "map"
# (absolute path; relative paths like ./map only work with the docker CLI, not in Portainer)
# MAP_DIR=/srv/minecraft-map

# Folder on the host with markers.json (own waypoints: bases, farms, shops; see README).
# Absolute path. Edit the file there; the page reads it on every load.
# MARKERS_DIR=/srv/map-markers

# Realm world slot 1-3 (default: the active one)
# REALM_SLOT=1

# Extra options for map-renderer build, e.g. biome maps (key B on the page),
# or only the Overworld incl. spawners
# BUILD_ARGS=--biomes
# BUILD_ARGS=--biomes --caves
# BUILD_ARGS=--dims overworld --extras

# Bedrock version sent to the Realms API, if it asks for a newer client
# REALMS_CLIENT_VERSION=1.26.30
